# Server
PORT=4173

# Public, non-secret iframe target. The app defaults to this value if unset.
PUBLIC_NOBOOK_LENS_RESOURCE_URL=https://wl.nobook.com/console/templates/resource/207_d2c4a829c23aa7471a0344a92e34cb74

# Optional DeepSeek Agent integration. Leave the key empty to use local fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional generic external Agent endpoint. DeepSeek is preferred when configured.
# The endpoint should accept JSON POST bodies. Its exact response contract must be confirmed before production use.
AGENT_API_URL=
AGENT_API_KEY=
